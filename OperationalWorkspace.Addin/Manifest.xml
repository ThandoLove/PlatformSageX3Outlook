<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

	<!-- ========================================================================= -->
	<!-- 1. ADD-IN IDENTITY CONFIGURATION (Preserves Existing Ecosystem Tokens)    -->
	<!-- ========================================================================= -->
	<Id>61f77d34-7389-4e09-9686-dcbbcdccbd1d</Id>
	<Version>1.0.0.0</Version>
	<ProviderName>PlatformSageX3OutlookProvider</ProviderName>
	<DefaultLocale>en-US</DefaultLocale>
	<DisplayName DefaultValue="Operational Sage X3 Workspace" />
	<Description DefaultValue="Enterprise Outlook add-in bridging email context with Sage X3 and Creatio workflows." />

	<!-- Asset Definitions for Legacy Desktop/Web Clients -->
	<IconUrl DefaultValue="https://localhost:7173/favicon.png" />
	<HighResolutionIconUrl DefaultValue="https://localhost:7173/favicon.png" />
	<SupportUrl DefaultValue="https://localhost:7173/support" />

	<!-- ========================================================================= -->
	<!-- 2. SECURITY, PERMISSIONS, & LEGACY FALLBACK ENGINES                      -->
	<!-- ========================================================================= -->
	<Hosts>
		<Host Name="Mailbox" />
	</Hosts>

	<Requirements>
		<Sets DefaultMinVersion="1.5">
			<Set Name="Mailbox" />
		</Sets>
	</Requirements>

	<!-- Grants required item body, read/write message, and attachment access scopes -->
	<Permissions>ReadWriteItem</Permissions>

	<!-- Legacy Activation Rules Engine -->
	<Rule xsi:type="RuleCollection" Mode="Or">
		<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
		<Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
	</Rule>

	<DisableEntityHighlighting>false</DisableEntityHighlighting>

	<!-- ========================================================================= -->
	<!-- 3. MODERN VERSION OVERRIDES (Unified Ribbon Surface Configuration)        -->
	<!-- ========================================================================= -->
	<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="VersionOverridesV1_0">
		<Description DefaultValue="Enterprise Outlook add-in bridging email context with Sage X3 and Creatio workflows." />

		<Requirements>
			<bt:Sets DefaultMinVersion="1.5">
				<bt:Set Name="Mailbox" />
			</bt:Sets>
		</Requirements>

		<Diagnostics />

		<!-- Authorized execution domain channels (Prevents Cross-Origin CORS blocking) -->
		<AppDomains>
			<AppDomain>https://localhost:7173</AppDomain>
			<AppDomain>https://localhost:7123</AppDomain>
		</AppDomains>

		<ExtensionPoints>

			<!-- A. MESSAGE READ VIEW SURFACE -->
			<ExtensionPoint xsi:type="MessageReadCommandSurface">
				<OfficeTab id="TabDefault">
					<Group id="grpX3OperationalWorkspace">
						<Label resid="lblWorkspaceGroup" />
						<Tooltip resid="tipWorkspaceGroup" />

						<Control xsi:type="Button" id="btnMainWorkspaceRead">
							<Label resid="lblOpenWorkspace" />
							<Supertip>
								<Title resid="lblOpenWorkspace" />
								<Description resid="tipOpenWorkspace" />
							</Supertip>
							<Icon>
								<bt:Image size="16" resid="icon16" />
								<bt:Image size="32" resid="icon32" />
								<bt:Image size="80" resid="icon80" />
							</Icon>
							<Action xsi:type="ShowTaskpane">
								<SourceLocation resid="tpWorkspaceUrl" />
								<RequestedHeight>600</RequestedHeight>
							</Action>
						</Control>
					</Group>
				</OfficeTab>
			</ExtensionPoint>

			<!-- B. MESSAGE COMPOSE SURFACE -->
			<ExtensionPoint xsi:type="MessageComposeCommandSurface">
				<OfficeTab id="TabDefault">
					<Group id="grpX3OperationalWorkspaceCompose">
						<Label resid="lblWorkspaceGroup" />
						<Tooltip resid="tipWorkspaceGroup" />

						<Control xsi:type="Button" id="btnMainWorkspaceCompose">
							<Label resid="lblOpenWorkspace" />
							<Supertip>
								<Title resid="lblOpenWorkspace" />
								<Description resid="tipOpenWorkspace" />
							</Supertip>
							<Icon>
								<bt:Image size="16" resid="icon16" />
								<bt:Image size="32" resid="icon32" />
							</Icon>
							<Action xsi:type="ShowTaskpane">
								<SourceLocation resid="tpWorkspaceUrl" />
								<RequestedHeight>600</RequestedHeight>
							</Action>
						</Control>
					</Group>
				</OfficeTab>
			</ExtensionPoint>

		</ExtensionPoints>

		<!-- ========================================================================= -->
		<!-- 4. CENTRALIZED STRING & ASSET RESOURCE DESCRIPTIONS                       -->
		<!-- ========================================================================= -->
		<Resources>
			<bt:Images>
				<bt:Image id="icon16" DefaultValue="https://localhost:7173/favicon.png" />
				<bt:Image id="icon32" DefaultValue="https://localhost:7173/favicon.png" />
				<bt:Image id="icon80" DefaultValue="https://localhost:7173/favicon.png" />
			</bt:Images>

			<bt:Urls>
				<!-- Single decoupled entry point route handling your Blazor workspace mapping -->
				<bt:Url id="tpWorkspaceUrl" DefaultValue="https://localhost:7173/taskpane" />
			</bt:Urls>

			<bt:ShortStrings>
				<bt:String id="lblWorkspaceGroup" DefaultValue="Sage X3 Link" />
				<bt:String id="lblOpenWorkspace" DefaultValue="Operational Workspace" />
			</bt:ShortStrings>

			<bt:LongStrings>
				<bt:String id="tipWorkspaceGroup" DefaultValue="Access enterprise transactional workflows, CRM connections, and ERP modules." />
				<bt:String id="tipOpenWorkspace" DefaultValue="Launches the interactive Sage X3 multi-tier dashboard running directly inside your secure Blazor container." />
			</bt:LongStrings>
		</Resources>
	</VersionOverrides>
</OfficeApp>
