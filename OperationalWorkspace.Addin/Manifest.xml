<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
 xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
 xsi:type="MailApp">

  <Id>61f77d34-7389-4e09-9686-dcbbcdccbd1d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>PlatformSageX3OutlookProvider</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Operational Sage X3 Workspace"/>
  <Description DefaultValue="Enterprise Outlook add-in bridging email context with Sage X3 and Creatio workflows."/>

  <IconUrl DefaultValue="https://localhost:7173/favicon.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:7173/favicon.png"/>

  <Hosts>
	<Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
	<Sets>
	  <Set Name="Mailbox" MinVersion="1.1"/>
	</Sets>
  </Requirements>

  <FormSettings>
	<Form xsi:type="ItemRead">
	  <DesktopSettings>
		<SourceLocation DefaultValue="https://localhost:7173/taskpane"/>
		<RequestedHeight>250</RequestedHeight>
	  </DesktopSettings>
	</Form>
	<Form xsi:type="ItemEdit">
	  <DesktopSettings>
		<SourceLocation DefaultValue="https://localhost:7173/taskpane"/>
	  </DesktopSettings>
	</Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
	<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Minimal VersionOverridesV1_0 for widest compatibility with Outlook clients -->
  <VersionOverrides
	  xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
	  xsi:type="VersionOverridesV1_0">

	<Requirements>
	  <bt:Sets DefaultMinVersion="1.5">
		<bt:Set Name="Mailbox"/>
	  </bt:Sets>
	</Requirements>

	<Hosts>
	  <Host xsi:type="MailHost">
		<DesktopFormFactor>
		  <FunctionFile resid="functionFile"/>

		  <ExtensionPoint xsi:type="MessageReadCommandSurface">
			<OfficeTab id="TabDefault">
			  <Group id="grpX3CrmActions">
				<Label resid="lblCrmGroup"/>
						<Control xsi:type="Button" id="btnOpenWorkspace">
						  <Label resid="lblOpenWorkspace"/>
						  <Supertip>
							<Title resid="lblOpenWorkspace"/>
							<Description resid="tipOpenWorkspace"/>
						  </Supertip>
						  <Icon>
							<bt:Image size="16" resid="icon16" />
							<bt:Image size="32" resid="icon32" />
							<bt:Image size="80" resid="icon80" />
						  </Icon>
						  <Action xsi:type="ShowTaskpane">
							<SourceLocation resid="tpWorkspaceUrl"/>
						  </Action>
						</Control>
			  </Group>
			</OfficeTab>
		  </ExtensionPoint>

		</DesktopFormFactor>
	  </Host>
	</Hosts>

	<Resources>
	  <bt:Images>
		<bt:Image id="icon16" DefaultValue="https://localhost:7173/favicon.png" />
		<bt:Image id="icon32" DefaultValue="https://localhost:7173/favicon.png" />
		<bt:Image id="icon80" DefaultValue="https://localhost:7173/favicon.png" />
	  </bt:Images>

	  <bt:Urls>
		<bt:Url id="functionFile" DefaultValue="https://localhost:7173/officeFunctionFile.html" />
		<bt:Url id="tpWorkspaceUrl" DefaultValue="https://localhost:7173/taskpane/workspace" />
	  </bt:Urls>

	  <bt:ShortStrings>
		<bt:String id="lblCrmGroup" DefaultValue="Sage CRM Link" />
		<bt:String id="lblOpenWorkspace" DefaultValue="Open Workspace" />
	  </bt:ShortStrings>

	  <bt:LongStrings>
		<bt:String id="tipOpenWorkspace" DefaultValue="Launches the Operational Workspace task pane." />
	  </bt:LongStrings>

	</Resources>
  </VersionOverrides>

</OfficeApp>
