@page "/taskpane/login"

@using OperationalWorkspaceApplication.DTOs
@using OperationalWorkspaceUI.Security
@using System.Net.Http.Json

@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<div class="sage-login-body">

    <!-- HEADER ICON -->

    <div class="login-icon-circle">

        <i class="ms-Icon ms-Icon--Lock"></i>

    </div>


    <!-- LOGIN TITLE -->

    <h2 class="login-title">

        Sign In To Sage X3

    </h2>


    <!-- LOGIN DESCRIPTION -->

    <p class="login-subtitle">

        Access your contextual operational workspace

    </p>


    <!-- LOGIN FORM -->

    <EditForm Model="loginModel"
              OnValidSubmit="HandleLogin">

        <DataAnnotationsValidator />


        <!-- USERNAME -->

        <div class="input-group-custom">

            <label>

                Username

            </label>


            <div class="input-wrapper">

                <i class="ms-Icon ms-Icon--Contact"></i>

                <InputText @bind-Value="loginModel.Username"
                           placeholder="operator@test.com or admin@test.com"
                           disabled="@isBusy" />

            </div>


            <ValidationMessage For="@(() => loginModel.Username)" />

        </div>


        <!-- PASSWORD -->

        <div class="input-group-custom">

            <label>

                Password

            </label>


            <div class="input-wrapper password-wrapper">

                <i class="ms-Icon ms-Icon--Lock"></i>


                <InputText @bind-Value="loginModel.Password"
                           type="@PasswordInputType"
                           placeholder="Enter password"
                           disabled="@isBusy" />


                <button type="button"
                        class="password-toggle-btn"
                        @onclick="TogglePassword"
                        disabled="@isBusy">

                    <i class="ms-Icon ms-Icon--RedEye"></i>

                </button>

            </div>


            <ValidationMessage For="@(() => loginModel.Password)" />

        </div>


        <!-- REMEMBER ME / FORGOT PASSWORD -->

        <div class="login-options">

            <label class="remember-option">

                <input type="checkbox"
                       @bind="RememberMe"
                       disabled="@isBusy" />

                <span>

                    Remember me

                </span>

            </label>


            <a href="#"
               class="forgot-link"
               @onclick:preventDefault="true">

                Forgot Password?

            </a>

        </div>


        <!-- ERROR MESSAGE -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="login-error">

                <i class="ms-Icon ms-Icon--ErrorBadge"></i>

                <span>

                    @ErrorMessage

                </span>

            </div>
        }


        <!-- NORMAL LOGIN -->

        <button type="submit"
                class="btn-login-submit"
                disabled="@isBusy">

            @if (isBusy && !isSsoLoading)
            {
                <span class="submit-spinner"></span>

                <span>

                    Authenticating...

                </span>
            }
            else
            {
                <i class="ms-Icon ms-Icon--Forward"></i>

                <span>

                    Sign In

                </span>
            }

        </button>


        <!-- DIVIDER -->

        <div class="login-divider">

            <span>

                or

            </span>

        </div>


        <!-- SSO LOGIN -->

        <button type="button"
                class="btn-sso-login @(isSsoLoading ? "sso-loading-active" : "")"
                @onclick="InitiateSSOAuthentication"
                disabled="@isBusy">

            @if (isSsoLoading)
            {
                <span class="sso-spinner"></span>

                <span>

                    Connecting to IDP...

                </span>
            }
            else
            {
                <i class="ms-Icon ms-Icon--Shield"></i>

                <span>

                    Sign in with SSO

                </span>
            }

        </button>

    </EditForm>

</div>


@code {

    private LoginRequestDto loginModel = new();

    private bool isBusy;

    private bool isSsoLoading;

    private bool RememberMe = true;

    private bool ShowPassword;

    private string? ErrorMessage;


    private string PasswordInputType =>
        ShowPassword ? "text" : "password";


    [Parameter]
    public EventCallback<(string Token, string User, string Email)>
        OnAuthenticationSuccess
    { get; set; }


    [Inject]
    private OperationalWorkspaceUI.UIServices.System.AuthService
        AuthService
    { get; set; } = default!;


    [Inject]
    private NavigationManager
        Nav
    { get; set; } = default!;


    [Inject]
    private OperationalWorkspaceUI.UIServices.System.ModalService
        ModalService
    { get; set; } = default!;


    [Inject]
    private Microsoft.AspNetCore.Hosting.IWebHostEnvironment
        Env
    { get; set; } = default!;


    [Inject]
    private HttpClient
        Http
    { get; set; } = default!;


    [Inject]
    private OperationalWorkspaceUI.State.UIState
        UIState
    { get; set; } = default!;


    [Inject]
    private OperationalWorkspaceApplication.ApplicationState.AppStateContainer
        AppState
    { get; set; } = default!;


    private void TogglePassword()
    {
        ShowPassword = !ShowPassword;
    }


    private async Task HandleLogin()
    {
        if (isBusy)
            return;

        try
        {
            isBusy = true;

            ErrorMessage = null;

            StateHasChanged();

            await Task.Delay(400);


            var success =
                await AuthService.LoginAsync(loginModel);


            if (!success)
            {
                ErrorMessage =
                    "Authentication rejected by environment security settings.";

                return;
            }


            if (AuthStateProvider
                is CustomAuthenticationStateProvider authProvider)
            {
                var authState =
                    await authProvider.GetAuthenticationStateAsync();

                UIState.SynchronizeUserSession(authState.User);
            }


            string extractionToken =
                "eyJhbGciOiJIUzI1Ni...";


            string extractionName =
                loginModel.Username.Contains("@")
                    ? loginModel.Username.Split('@')[0]
                    : loginModel.Username;


            string extractionEmail =
                loginModel.Username;


            AppState.SetAuthentication(
                extractionToken,
                extractionName,
                extractionEmail
            );


            if (OnAuthenticationSuccess.HasDelegate)
            {
                await OnAuthenticationSuccess.InvokeAsync(
                    (
                        extractionToken,
                        extractionName,
                        extractionEmail
                    )
                );
            }
            else
            {
                await ModalService.CloseModal();

                Nav.NavigateTo(
                    "/taskpane/workspace",
                    forceLoad: false
                );
            }
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Authentication failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;

            StateHasChanged();
        }
    }


    private async Task InitiateSSOAuthentication()
    {
        if (isBusy)
            return;

        try
        {
            isBusy = true;

            isSsoLoading = true;

            ErrorMessage = null;

            StateHasChanged();


            string targetToken =
                "sso_bypass_marker";

            string targetUser =
                "SSO Operator";

            string targetEmail =
                "sso.operator@test.com";


            if (Env.IsDevelopment())
            {
                await Task.Delay(1000);


                var ssoMockDto =
                    new LoginRequestDto
                    {
                        Username = targetEmail,
                        Password = targetToken
                    };


                await AuthService.LoginAsync(ssoMockDto);
            }
            else
            {
                var authResult =
                    await Http.GetFromJsonAsync<LoginResponse>(
                        "/api/v1/auth/sso/challenge"
                    );


                if (authResult is null ||
                    string.IsNullOrWhiteSpace(authResult.Token))
                {
                    ErrorMessage =
                        "Single Sign-On authentication handshake rejected or timed out.";

                    return;
                }


                targetToken =
                    authResult.Token;


                targetUser =
                    "SSO Corporate Node";


                targetEmail =
                    "sso.production@test.com";


                var ssoProdDto =
                    new LoginRequestDto
                    {
                        Username = targetEmail,
                        Password = targetToken
                    };


                await AuthService.LoginAsync(ssoProdDto);
            }


            if (AuthStateProvider
                is CustomAuthenticationStateProvider authProvider)
            {
                var authState =
                    await authProvider.GetAuthenticationStateAsync();

                UIState.SynchronizeUserSession(authState.User);
            }


            AppState.SetAuthentication(
                targetToken,
                targetUser,
                targetEmail
            );


            if (OnAuthenticationSuccess.HasDelegate)
            {
                await OnAuthenticationSuccess.InvokeAsync(
                    (
                        targetToken,
                        targetUser,
                        targetEmail
                    )
                );
            }
            else
            {
                await ModalService.CloseModal();

                Nav.NavigateTo(
                    "/taskpane/workspace",
                    forceLoad: false
                );
            }
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Single Sign-On initialization failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;

            isSsoLoading = false;

            StateHasChanged();
        }
    }


    public class LoginResponse
    {
        public string? Token { get; set; }
    }

}