@page "/taskpane"
@page "/taskpane/{**path}"
@layout TaskPaneLayout

@using Microsoft.AspNetCore.Components

@using OperationalWorkspaceUI.Components.Pages.Dashboard
@using OperationalWorkspaceApplication.ApplicationState
@using OperationalWorkspaceUI.Components.Pages.Forms
@using OperationalWorkspaceUI.Components.Pages.TaskPane
@using OperationalWorkspaceUI.Components.Pages.Workspace.WorkspaceComponents


@implements IDisposable
@inject AppStateContainer AppState
@inject IJSRuntime JS
@inject NavigationManager Nav

<!-- ✅ FIX 1: Enforce a dedicated CSS wrapper container that clips desktop styling properties
     and forces your real components to adapt cleanly to a portrait sidebar panel context! -->
<div class="taskpane-embedded-wrapper" style="width: 100%; height: 100vh; overflow-y: auto; overflow-x: hidden; background: #ffffff; padding: 12px; box-sizing: border-box;">

    @if (AppState.IsAuthenticated && _componentType != null)
    {
        <DynamicComponent Type="_componentType" Parameters="_parameters" />
    }
    else if (!AppState.IsAuthenticated)
    {
        <!-- Underlying background canvas stays locked; TaskPaneLayout throws the modal on top -->
        <Home />
    }
    else
    {
        <div class="taskpane-fallback" style="text-align: center; padding-top: 40px; color: #605e5c; font-family: sans-serif;">
            <h4 style="font-size: 14px; margin-bottom: 4px;">Navigation Route Resolved Bypassed</h4>
            <p style="font-size: 11px; margin-bottom: 12px;">Active path state lookup: @_requestedPath</p>
            <button style="background: #0078d4; color: #ffffff; border: none; padding: 6px 12px; border-radius: 4px; font-size: 11px; cursor: pointer;" @onclick="FallbackToDashboard">Go to Dashboard</button>
        </div>
    }

</div>

@code {
    [Parameter]
    public string? path { get; set; }

    private string _requestedPath = string.Empty;
    private Type? _componentType;
    private Dictionary<string, object>? _parameters;

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleSecurityStateChange;
    }

    protected override void OnParametersSet()
    {
        _requestedPath = (path ?? string.Empty).Trim('/').ToLowerInvariant();
        MapPathToComponent(_requestedPath);
    }

    private void MapPathToComponent(string p)
    {
        // ✅ FIX 2: Group and map manifest requests cleanly directly to your REAL components.
        // This solves the URL jumping bugs because truncated paths fall cleanly into folder groups!

        // 1. Dashboard, CRM Snapshots, Customer and AI Summary mappings
        if (
      string.IsNullOrWhiteSpace(p)
      || p == "workspace"
  )
        {
            _componentType = typeof(Dashboard);
        }

        // 2. Contacts / Add-Contact mappings
        else if (p.StartsWith("contact"))
        {
            _componentType = typeof(NewContactForm); // Loads your real flat /forms/add-contact component!
        }

        // 3. Compose Ribbon Commands Group
        else if (p.StartsWith("compose"))
        {
            if (p.Contains("attach-documents"))
            {
                _componentType = typeof(Attachments); // Loads your real flat /attachments component!
            }
            else if (p.Contains("followup"))
            {
                _componentType = typeof(Activity); // Loads your real flat /activities component!
            }
            else
            {
                _componentType = typeof(ComposePage); // Base fallback for text template insertions
            }
        }

        // 4. Tasks mappings
        else if (p.StartsWith("task"))
        {
            _componentType = typeof(Tasks); // Loads your real flat /tasks component!
        }

        else if (p.StartsWith("customer"))
        {
            _componentType = typeof(BusinessPartner);
        }

        else if (p.StartsWith("orders"))
        {
            _componentType = typeof(Orders);
        }

        else if (p.StartsWith("ai"))
        {
            _componentType = typeof(AISummary);
        }

        // 5. Explicit safety fallback matching
        else
        {
            _componentType = null;
        }

        _parameters = _componentType != null ? new Dictionary<string, object>() : null;
    }

    private void FallbackToDashboard()
    {
        Nav.NavigateTo("/taskpane/workspace", forceLoad: false);
    }

    private void HandleSecurityStateChange()
    {
        InvokeAsync(() =>
        {
            MapPathToComponent(_requestedPath);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleSecurityStateChange;
    }
}
